# ArchSynth Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Required: Google Gemini API Key (free tier at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Local Ollama for open-weight models (cost control)
# Install Ollama: https://ollama.ai/
# Pull model: ollama pull qwen2.5-coder
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder

# Optional: GitHub token for private repos (not needed for public nav2)
# GITHUB_TOKEN=your_github_token_here

# Optional: Logging level
# LOG_LEVEL=INFO